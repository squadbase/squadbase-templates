{
  "name": "@squadbase/vantage-template",
  "version": "0.0.2",
  "description": "CLI tool for initializing and customizing Squadbase Vantage projects.",
  "keywords": [
    "squadbase",
    "vantage",
    "dashboard",
    "template",
    "scaffolding",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/squadbase/squadbase-templates.git",
    "directory": "vantage-template"
  },
  "homepage": "https://github.com/squadbase/squadbase-templates/tree/main/vantage-template#readme",
  "bugs": {
    "url": "https://github.com/squadbase/squadbase-templates/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "squadbase-vantage-template": "./dist/index.js"
  },
  "files": [
    "dist",
    "ui-templates",
    "base-template",
    "chart-presets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-base": "rsync -a --delete --exclude='node_modules' --exclude='dist' --exclude='.vantage' --exclude='package-lock.json' --exclude='*.tsbuildinfo' --exclude='*.log' ../vantage/ base-template/ && mv base-template/.gitignore base-template/_gitignore",
    "build": "npm run sync-base && tsup",
    "prepublishOnly": "npm --prefix .. run agents:check && npm run build",
    "release": "npm publish --@squadbase:registry=https://registry.npmjs.org",
    "dev": "node scripts/dev.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "playwright": "^1.49.0",
    "tsup": "^8.4.0",
    "typescript": "~5.7.0"
  },
  "optionalDependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^4.0.0"
  }
}
